# ===================================================================
#  AI 模型接入配置模板
# -------------------------------------------------------------------
#  使用方式：复制本文件为 .env（同目录），填入你的密钥即可。
#    Windows PowerShell : Copy-Item .env.example .env
#    macOS / Linux      : cp .env.example .env
#
#  ⚠️ .env 已被 .gitignore 忽略，请勿提交到仓库。
#  ⚠️ 本文件中的变量只在 **Node 代理服务端** 读取，不会打包进前端产物。
# ===================================================================

# ---- 密钥（必填，留空则自动降级为 Mock 模式）----
# 智谱开放平台获取：https://open.bigmodel.cn  →  API Keys
AI_API_KEY=

# ---- 模型与端点（换厂商只需改这两行）----
# 智谱 GLM-4V 可选：glm-4v-flash（轻量免费）/ glm-4v / glm-4v-plus
AI_MODEL=glm-4v-flash
# 智谱 OpenAI 兼容端点；其他厂商示例见 docs/AI接入说明.md
AI_API_BASE=https://open.bigmodel.cn/api/paas/v4

# ---- 服务与稳定性参数 ----
# 代理服务端口（需与 VITE_AI_PROXY_TARGET 保持一致）
AI_PROXY_PORT=8787
# 单次请求超时（毫秒）
AI_TIMEOUT_MS=20000
# 5xx 服务端故障 / 网络抖动的最大重试次数，采用指数退避
# 注意：HTTP 429 限流不在重试范围（立即重试只会加剧限流，前端会自动降级）
AI_MAX_RETRY=2
# 强制 Mock：1 = 不请求真实模型，直接用确定性模拟响应（断网演示用）
AI_MOCK=0
# 单张图片体积上限（字节），默认 8MB
AI_MAX_IMAGE_BYTES=8388608

# ---- AI 营养对话助手（/api/chat）----
# 对话用的文本模型，与视觉模型分开配置（视觉模型不擅长纯文本长对话）
# 推荐 glm-5.3-flash：新用户赠送 1500 万 tokens 资源包，限流配额宽松、高峰期稳定
# 免费的 glm-4.7-flash 高峰期 QPS 很低，频繁返回 429，仅建议错峰使用
AI_CHAT_MODEL=glm-5.3-flash
# 流式对话的「空闲超时」：每收到一个数据块就重置计时，
# 避免长回答被整体超时切断（与 AI_TIMEOUT_MS 是两套机制）
AI_CHAT_IDLE_MS=20000
# 上下文轮数上限（超出则只保留最近的对话，控制 token 消耗）
AI_CHAT_MAX_TURNS=12
# 单条消息最大字符数（防止提示词注入式超长输入）
AI_CHAT_MAX_CHARS=2000

# ===================================================================
#  前端（Vite）配置
#  注意：只有以 VITE_ 开头的变量才会被 Vite 注入浏览器。
#  这里**不要**放任何密钥。
# ===================================================================

# 前端请求路径前缀；开发环境由 Vite 代理转发到上面的代理服务
VITE_AI_ENDPOINT=/api
# 前端等待上限（毫秒），建议略大于 AI_TIMEOUT_MS
VITE_AI_TIMEOUT_MS=25000
# 1 = 前端完全不发请求，直接用内置 Mock 响应（无网络也能演示）
VITE_AI_MOCK=0
# Vite 代理目标（改了 AI_PROXY_PORT 记得同步改这里）
VITE_AI_PROXY_TARGET=http://localhost:8787
